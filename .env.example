# Database
DATABASE_URL=

# Admin
# Gates /admin (HTTP Basic Auth) and the cron endpoint (Bearer token)
ADMIN_PASSWORD=

# AI provider
# Set exactly one of these or add a provider - reference README.md, matching whichever provider src/engine/config/providers.ts
# exports and src/engine/lib/digest.ts imports. Default wiring is Anthropic direct.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Generation tuning (all optional, defaults in src/engine/config/generation.ts)
GENERATION_MODEL=
GENERATION_MAX_OUTPUT_TOKENS=
GENERATION_MAX_SEARCHES=
GENERATION_MIN_ENTRIES=
GENERATION_MAX_ENTRIES=

# Deep read (fetches and reads full source articles instead of search snippets)
# Anthropic-only right now. 
NEXT_PUBLIC_GENERATION_DEEP_READ_ENABLED=
GENERATION_MAX_FETCHES=
GENERATION_DEEP_READ_DEFAULT=
